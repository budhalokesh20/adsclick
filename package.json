{
  "name": "adshare-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AdShare platform API — Node.js / TypeScript / Express / Prisma",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:makemigration": "prisma migrate dev --create-only",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "6.13.0",
    "argon2": "0.41.1",
    "cors": "2.8.5",
    "decimal.js": "10.4.3",
    "dotenv": "16.4.7",
    "express": "5.0.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "ioredis": "^5.4.1",
    "jose": "5.9.6",
    "pino": "9.7.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "6.13.0",
    "supertest": "^7.1.3",
    "tsx": "4.20.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
