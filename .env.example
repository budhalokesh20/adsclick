# ---- AdShare backend environment (example) ----
# Copy to .env and fill real values. NEVER commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adshare

# Redis (used by BullMQ workers in later phases)
REDIS_URL=redis://127.0.0.1:6379

# JWT access token signing secret (min 32 chars)
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_ACCESS_TTL=15m

# Refresh token lifetime (days)
REFRESH_TOKEN_TTL_DAYS=30

# Application encryption key for fields-at-rest (min 32 chars)
APP_ENC_KEY=change-me-encryption-key-32-chars

# Google Sign-In (see docs/13-google-login.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_ANDROID=

# SMTP email delivery (verification codes, password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@adshare.local

# CORS: comma-separated origins or * for dev
CORS_ORIGINS=*

# Set true behind nginx (trust X-Forwarded-*)
TRUST_PROXY=false

# Rate limiting (disable for tests/CI)
RATE_LIMIT_ENABLED=true

# Seed admin credentials (used only by `npm run db:seed`)
ADMIN_SEED_EMAIL=admin@adshare.local
ADMIN_SEED_PASSWORD=ChangeMe123!
# Featured in development only; rotate before any production use.
